# Copy this file to .env and fill in your DeepSeek API key.
# Get a key at https://platform.deepseek.com/

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# Optional overrides (defaults shown below)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# HTTP behaviour
REQUEST_TIMEOUT=60
MAX_RETRIES=3
RETRY_BACKOFF=1.0
RETRY_JITTER=0.5

# ---------------------------------------------------------------------------
# V1.0 — Cloudflare Worker 临时 Key 分发（Worker 优先，手动 Key 兜底）
# 配置后客户端会先从 Worker 取 24h 临时 Key（绑定设备指纹、每设备每日限额），
# Worker 不可用/限额用尽时才回退到上面的 DEEPSEEK_API_KEY。
# 部署说明见 workers/get-key.js 与 wrangler.toml。
# RECALLOS_WORKER_URL=https://recallos-key-server.你的账号.workers.dev

# 用量监控脚本（scripts/monitor_usage.py）用到的环境变量
# TELEGRAM_BOT_TOKEN=123456:your-bot-token      # @BotFather 申请
# TELEGRAM_CHAT_ID=your-chat-id
# REVOKE_SECRET=your-long-random-admin-secret   # 与 workers/get-key.js 里 ADMIN_SECRET 一致
# DAILY_TOKEN_THRESHOLD=500000
# DAILY_REQUEST_THRESHOLD=50
# REQUEST_TOKEN_ESTIMATE=5000
